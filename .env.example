# VoltEdge — Supabase connection (copy this file to ".env" and fill in).
#
#   Copy-Item .env.example .env      (Windows PowerShell)
#   cp .env.example .env             (bash)
#
# Then build the browser config:  node scripts/build-env.mjs
# And test the connection:        node scripts/check-supabase.mjs
#
# ── ONLY browser-safe values belong here ─────────────────────────────────────
# Use the PROJECT URL + PUBLISHABLE (anon/public) KEY.
# NEVER put a service_role key or an "sb_secret_..." key in this file — it would
# be shipped to every visitor's browser. scripts/build-env.mjs refuses to build
# if it detects a privileged key.
#
# Find both values in the dashboard: Project Settings -> API Keys.

# e.g. https://abcdefghijklmnop.supabase.co
SUPABASE_URL=

# Publishable key (new style "sb_publishable_..." ) or legacy anon key (JWT "eyJ...").
SUPABASE_PUBLISHABLE_KEY=

# Optional. Leave unset to auto-enable LIVE whenever URL + key are present.
# Set to "false" to force the app to stay on MOCK data even when configured.
# USE_SUPABASE=false

# Mailgun server-side settings (configure as Vercel environment variables).
# The key is used only by the Vercel function in /api and must never be exposed
# to browser JavaScript. Keep the allowed-recipient list restricted for sandbox.
MAILGUN_SEND_ENABLED=
MAILGUN_API_KEY=
MAILGUN_DOMAIN=
MAILGUN_FROM=
MAILGUN_ALLOWED_RECIPIENTS=
